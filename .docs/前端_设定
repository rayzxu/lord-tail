        {name: &quot;尺寸傲人&quot;, desc: &quot;（男性专属）极具视觉冲击力，女性见之腿软。&quot;},
        {name: &quot;紧致名器&quot;, desc: &quot;（女性专属）能轻易让邻国国王精尽人亡。&quot;},
        {name: &quot;扶他之神&quot;, desc: &quot;（扶他专属）同时具备男女优势，征服一切性别。&quot;},
        {name: &quot;神圣审判&quot;, desc: &quot;以异端之名烧死平民，不仅增加统治力还增加民心。&quot;},
        {name: &quot;时间管理&quot;, desc: &quot;一轮（9天）内可下达双倍的建筑指令。&quot;},
        {name: &quot;领主初夜&quot;, desc: &quot;新婚妻子必须先送入城堡，丈夫还要在门外感恩。&quot;},
        {name: &quot;骨肉相食&quot;, desc: &quot;极度饥荒时，平民会自发互食而不发生暴动。&quot;},
        {name: &quot;狂热近卫&quot;, desc: &quot;拥有一支只听命于你的死士，免疫任何策反。&quot;},
        {name: &quot;肉体税&quot;, desc: &quot;交不起金币的家庭必须交出长女/长子抵债。&quot;},
        {name: &quot;永恒暴君&quot;, desc: &quot;无论做多过分的事，总有一批死忠粉为你辩护。&quot;}
    ];

    let selectedTalents = [];

    function getRandomTalents(arr, count) {
        const shuffled = [...arr].sort(() =&gt; 0.5 - Math.random());
        return shuffled.slice(0, count);
    }

    function rollTalents() {
        const container = document.getElementById('talentContainer');
        container.innerHTML = '';
        selectedTalents = [];
        updateCount();

        const currentTalents = getRandomTalents(allTalents, 10);
        
        currentTalents.forEach((talent, index) =&gt; {
            const div = document.createElement('div');
            div.className = 'talent-item';
            div.onclick = function(e) {
                if (e.target.tagName !== 'INPUT') {
                    const checkbox = this.querySelector('input');
                    checkbox.checked = !checkbox.checked;
                    handleSelection(checkbox, talent);
                }
            };

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.value = talent.name;
            checkbox.onclick = function(e) {
                handleSelection(this, talent);
                e.stopPropagation();
            };

            const info = document.createElement('div');
            info.className = 'talent-info';
            info.innerHTML = `&lt;span class=&quot;talent-name&quot;&gt;${talent.name}&lt;/span&gt;&lt;div class=&quot;talent-desc&quot;&gt;${talent.desc}&lt;/div&gt;`;

            div.appendChild(checkbox);
            div.appendChild(info);
            container.appendChild(div);
        });
    }

    function handleSelection(checkbox, talent) {
        if (checkbox.checked) {
            if (selectedTalents.length &gt;= 2) {
                checkbox.checked = false;
                alert(&quot;最多只能选择2个命运赐福！贪心可是会下地狱的哦~&quot;);
                return;
            }
            selectedTalents.push(talent);
        } else {
            selectedTalents = selectedTalents.filter(t =&gt; t.name !== talent.name);
        }
        updateCount();
    }

    function updateCount() {
        document.getElementById('talentCount').innerText = `已选: ${selectedTalents.length} / 2`;
    }

    function generatePrompt() {
        const name = document.getElementById('lordName').value || '无名领主';
        const gender = document.getElementById('lordGender').value;
        const domain = document.getElementById('domainName').value || '无名之地';
        
        // 获取新增的外表和性格设定
        const appearance = document.getElementById('lordAppearance').value || '未详细设定（由AI根据你的行为自由脑补）';
        const personality = document.getElementById('lordPersonality').value || '深不可测的深渊性格';

        if (selectedTalents.length !== 2) {
            alert(&quot;请务必选择2个命运赐福！&quot;);
            return;
        }

        const t1 = `${selectedTalents[0].name}（${selectedTalents[0].desc}）`;
        const t2 = `${selectedTalents[1].name}（${selectedTalents[1].desc}）`;

        const prompt = `请作为【中世纪庄园模拟器内核】接收我的初始设定。

我的初始设定如下：
- 领主姓名：${name}
- 领主性别：${gender}
- 领地名称：${domain}
- 领主外表：${appearance}
- 领主性格：${personality}
- 初始天赋1：${t1}（请在后续演算中严格应用此天赋效果）
- 初始天赋2：${t2}（请在后续演算中严格应用此天赋效果）

**开局要求：**
1. 游戏从【第1轮 ｜ 春季 ｜ 细雨】开始。
2. 初始领地大盘：民心50，统治力50，人口100，金币500，粮食500。
3. 初始地图：在10x10的空地（🟩）正中央（E5）有一座领主堡垒（🏰），旁边（E6）有几间破旧房屋（🏘️）。
4. 请用极具中世纪压迫感的笔触，描写我（领主）站在泥泞的城堡阳台上俯瞰领地的第一幕。结合我的性别、外表、性格和天赋，描写周围仆人或卫兵对我敬畏/恐惧/痴迷的态度，以及我内心所想。
5. 在回复末尾输出第一轮的【交互状态面板】和【战术地图】。
6. 询问我下达的第一个指令（建筑/法令/互动）。`;

        document.getElementById('promptOutput').value = prompt;
        document.getElementById('resultBox').style.display = 'block';
        
        // 滚动到底部
        document.getElementById('resultBox').scrollIntoView({ behavior: 'smooth' });
    }

    function copyText() {
        const text = document.getElementById('promptOutput');
        text.select();
        document.execCommand('copy');
        alert(&quot;剧本已复制！快去发送给AI开始你的暴君之路吧！&quot;);
    }

    // 初始化随机一次
    window.onload = rollTalents;
&lt;/script&gt;

